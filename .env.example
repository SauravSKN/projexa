# ==========================================
# PROJEXA Server Configuration
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (MongoDB)
# Local development database name MUST contain dev, test, or local for safety guards
MONGODB_URI=mongodb://localhost:27017/projexa_dev
# Dedicated database used by the automated test suite (never a real database)
MONGODB_URI_TEST=mongodb://localhost:27017/projexa_test

# Authentication Secrets (Backend Member 3)
# JWT_SECRET or SESSION_SECRET must be at least 32 characters in production
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
SESSION_SECRET=replace_with_a_secure_session_secret_at_least_32_chars
# Access token lifetime in minutes (session records are revoked server-side on logout)
SESSION_TTL_MINUTES=60
TOKEN_EXPIRES_IN=1h

# Admin provisioning (Backend Member 3 CLI: npm run provision:admin)
# Only used by scripts/provisionAdmin.js, never by the HTTP API.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace_with_a_strong_provisioning_password
ADMIN_FULL_NAME=Example Administrator
ADMIN_ROLE=admin
# Required in production before the provisioning script will run
ALLOW_ADMIN_PROVISION=false

# Seed Configuration (Member 4 Development Fixtures)
ALLOW_DEV_SEED=true
SEED_DEMO_PASSWORD=DevSecretPassword123!

# Client CORS Configuration
CLIENT_ORIGIN=http://localhost:5173
# Set to true when serving over HTTPS so session cookies are marked Secure
COOKIE_SECURE=false
# Set to true only when the app runs behind a trusted reverse proxy
TRUST_PROXY=false

# ==========================================
# PROJEXA Client Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api/v1
